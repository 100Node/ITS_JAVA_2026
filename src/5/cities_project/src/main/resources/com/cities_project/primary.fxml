<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane dividerPositions="0.4" prefHeight="500.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cities_project.PrimaryController">
  <items>
    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
         <children>
            <Label layoutX="20.0" layoutY="30.0" text="ID:" />
            <TextField fx:id="tfId" editable="false" layoutX="120.0" layoutY="25.0" prefWidth="200.0" promptText="Auto-generated" />
            
            <Label layoutX="20.0" layoutY="70.0" text="Name:" />
            <TextField fx:id="tfName" layoutX="120.0" layoutY="65.0" prefWidth="200.0" />
            
            <Label layoutX="20.0" layoutY="110.0" text="Latitude, deg:" />
            <TextField fx:id="tfLat" layoutX="120.0" layoutY="105.0" prefWidth="200.0" />
            
            <Label layoutX="20.0" layoutY="150.0" text="Longitude, deg:" />
            <TextField fx:id="tfLon" layoutX="120.0" layoutY="145.0" prefWidth="200.0" />
            
            <Label layoutX="20.0" layoutY="190.0" text="Region:" />
            <ComboBox fx:id="cbRegion" layoutX="120.0" layoutY="185.0" prefWidth="200.0" />
            
            <Label layoutX="20.0" layoutY="230.0" text="Photo:" />
            <Button layoutX="120.0" layoutY="225.0" mnemonicParsing="false" onAction="#handleChoosePhoto" text="Browse..." />
            <Label fx:id="lblPhotoPath" layoutX="190.0" layoutY="230.0" text="No file selected" textFill="#757575" />
            
            <Button layoutX="20.0" layoutY="350.0" mnemonicParsing="false" onAction="#handleInsert" prefWidth="80.0" text="Insert" />
            <Button layoutX="120.0" layoutY="350.0" mnemonicParsing="false" onAction="#handleUpdate" prefWidth="80.0" text="Update" />
            <Button layoutX="220.0" layoutY="350.0" mnemonicParsing="false" onAction="#handleClear" prefWidth="80.0" text="Clear" />
            <Button layoutX="20.0" layoutY="400.0" mnemonicParsing="false" onAction="#handleRefresh" prefWidth="80.0" text="Refresh" />
            <Button layoutX="120.0" layoutY="400.0" mnemonicParsing="false" onAction="#handleDelete" prefWidth="80.0" text="Delete" />
         </children>
    </AnchorPane>
    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
         <children>
            <TableView fx:id="tvSites" layoutX="14.0" layoutY="14.0" onMouseClicked="#handleMouseAction" prefHeight="498.0" prefWidth="536.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="120.0" text="Name" />
                <TableColumn fx:id="colLat" prefWidth="70.0" text="Latitude" />
                <TableColumn fx:id="colLon" prefWidth="70.0" text="Longitude" />
                <TableColumn fx:id="colRegion" prefWidth="100.0" text="Region" />
                <TableColumn fx:id="colPhoto" prefWidth="120.0" text="Photo" />
              </columns>
            </TableView>
         </children>
    </AnchorPane>
  </items>
</SplitPane>